ENVIRONMENT=development
# Генерируйте случайную строку: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=1440
# На боевом домене перечислите адреса через запятую вместо *
CORS_ORIGINS=*

# --- Сессии и cookies ---
# Панель авторизуется HttpOnly-cookie, а не токеном в localStorage.
# CSRF-токен лежит в читаемой cookie и дублируется в X-CSRF-Token.
SESSION_COOKIE_NAME=aisd_session
CSRF_COOKIE_NAME=aisd_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_COOKIE_SAMESITE=lax
# Обязательно true на HTTPS: по HTTP cookie утекут в открытом виде.
# Локально (http://localhost) оставляйте false, иначе вход не сработает.
SESSION_COOKIE_SECURE=false

# --- Мастер-ключ шифрования ---
# Fernet-ключ для токенов Telegram-ботов. Не меняйте после старта: сохранённые
# токены перестанут расшифровываться. Пусто — берётся SECRET_KEY.
SECRETS_MASTER_KEY=

# --- Лимиты и защита от подбора ---
# Вход: попыток в минуту с одной пары IP+email.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Блокировка после неудачных попыток входа, минут.
LOGIN_LOCKOUT_MINUTES=15
# Обращений в минуту на команду с одного IP через /api/ingest/message.
INGEST_RATE_LIMIT_PER_MINUTE=60
# Общий лимит панельных запросов в минуту.
API_RATE_LIMIT_PER_MINUTE=600
# Журнал действий: входы, выпуск и отзыв ключей, просмотр обращений.
AUDIT_ENABLED=true
# Доверять X-Forwarded-For / X-Real-IP (адрес клиента для лимитов и аудита).
# Включайте только за обратным прокси: без него заголовок подделывает сам клиент.
TRUST_PROXY_HEADERS=false

# --- База данных ---
# По умолчанию (если не задано) используется SQLite — ничего ставить не нужно.
# Для продакшена рекомендуется PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
# DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db

POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support

# --- Аккаунты и демо ---
ALLOW_REGISTRATION=true
ADMIN_EMAIL=admin@example.com
# Минимум 10 символов, не только цифры, не из списка слабых.
ADMIN_PASSWORD=change-me-strong-pass
ADMIN_NAME=Support Admin
SEED_DEMO_DATA=true
DEMO_WORKSPACE_NAME=Acme Support
# Пересоздавать схему при несовпадении модели (после обновления кода)
AUTO_RESET_SCHEMA=false

# --- Публичный адрес: используется в коде виджета и ссылках интеграции ---
PUBLIC_BASE_URL=http://localhost:8000

# --- LLM: Groq (бесплатно) ---
# Groq работает по OpenAI-совместимому API. openai/gpt-oss-120b — reasoning-модель:
# сначала «размышляет» и тратит на это токены, поэтому LLM_MAX_TOKENS нужен с запасом.
# Подойдёт любой OpenAI-совместимый сервер: OpenAI, локальный Ollama.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_SECONDS=90
# Глубина размышления gpt-oss: low | medium | high
LLM_REASONING_EFFORT=low

# Groq не отдаёт эмбеддинги (HTTP 404), поэтому поиск по базе знаний считается
# локальным лексическим вектором. Он понимает совпадение слов, но не смысл.
EMBEDDING_DIM=1536

RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.05
AUTO_REPLY_MIN_SCORE=0.5

# --- Мультитенантность ---
# Каждой комнате выдаётся свой ключ (X-Workspace-Key) и именованные ключи.
# CHANNEL_API_KEY — запасной вариант для старых интеграций: если по нему приходит
# сообщение и ключ не совпал ни с одной командой, обращение уходит в первую комнату.
CHANNEL_API_KEY=dev-channel-key
# Ключ воркера Telegram-бота для доступа к списку подключённых команд и heartbeat.
WORKER_API_KEY=dev-worker-key

# --- Telegram ---
# Токены ботов вводятся в панели (Интеграции → Telegram) и проверяются через getMe.
TELEGRAM_API_BASE=https://api.telegram.org
# Таймаут проверки токена, секунды
TELEGRAM_VERIFY_TIMEOUT=12
# Встроенный воркер поднимает ботов в процессе приложения. Поставьте false, только
# если запускаете ботов отдельным процессом (bots/telegram/bot.py).
TELEGRAM_WORKER_ENABLED=true
